#!/usr/bin/env bash
# Lanza Claude Code con el entorno de este repositorio.
#
# Existe por un motivo concreto: la expansión ${GITHUB_PAT} de .mcp.json lee el
# entorno del proceso que arranca `claude`, y NO el bloque "env" de
# .claude/settings.local.json. Sin este arranque, el servidor MCP de GitHub se
# conecta sin credencial y falla.
#
# Uso:  ./bin/dilema        (en vez de `claude`)
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

if [[ ! -f .env ]]; then
  echo "No hay .env. Copia .env.example a .env y rellena GITHUB_PAT." >&2
  exit 1
fi

set -a
# shellcheck disable=SC1091
. ./.env
set +a

if [[ -z "${GITHUB_PAT:-}" ]]; then
  echo "GITHUB_PAT está vacío en .env. El MCP de GitHub no podrá autenticarse." >&2
  exit 1
fi

exec claude "$@"
